rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Checked by reading the REQUESTER's own profile — this is a
    // privileged internal read Firestore rules allow specifically for
    // authorization checks; it does not re-trigger these same rules.
    // Top-level so every collection's rules below can reuse it.
    function isActiveAdmin() {
      let requester = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && requester.role == 'admin' && requester.status == 'active';
    }

    match /users/{userId} {
      function isSelf() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Single-document reads: a user reading their own profile, or an
      // active admin reading any single profile.
      allow get: if isSelf() || isActiveAdmin();

      // Collection queries (including count aggregations, e.g. the admin
      // dashboard's "active students" stat) — admin only. A student must
      // never be able to list/query every user in the platform.
      allow list: if isActiveAdmin();

      // A profile may only be self-created as an active student — matches
      // AuthService's Google sign-in auto-create policy exactly
      // (docs/03-Features/01-Authentication.md, BR-005: only
      // administrators create accounts otherwise; self-creation is
      // deliberately limited to the least-privileged role).
      allow create: if isSelf()
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active';

      // Users may update their own profile (e.g. lastLogin/updatedAt on
      // every sign-in) but can never change their own role or status —
      // that would be self-promotion / self-reactivation, which only an
      // administrator should be able to do (future M8 admin panel).
      allow update: if isSelf()
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.status == resource.data.status;

      // No client-side deletes in Phase 1 (docs/04-Engineering/02-Database-Design.md
      // "Avoid hard deletion" — disable via status instead).
      allow delete: if false;
    }

    match /missions/{missionId} {
      // Admins can read any single mission (any status) or list without
      // constraint. Non-admins can read/list only published missions —
      // drafts must never be visible to students (mirrors BR-ANN-004's
      // "Draft announcements are invisible to students" — same principle
      // applies here even though not separately numbered for missions).
      // Archived missions stay readable so students retain history access
      // to missions they were previously assigned.
      allow get: if isActiveAdmin()
                 || (request.auth != null && resource.data.status != 'draft');
      allow list: if isActiveAdmin()
                  || (request.auth != null && resource.data.status == 'published');

      // Only admins create/edit missions. Deeper lifecycle rules (e.g.
      // "archived missions cannot be edited") are enforced by
      // MissionService at the application layer, not duplicated here —
      // this rule is the authorization boundary, not the full business
      // rule set (docs/04-Engineering/01-System-Architecture.md's 3-layer
      // validation: UI -> Application Service -> Firestore Rules).
      allow create: if isActiveAdmin()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.status in ['draft', 'published'];
      allow update: if isActiveAdmin();

      // No hard deletes — "delete" is archiving via update, same pattern
      // as users.
      allow delete: if false;
    }

    match /missionAssignments/{assignmentId} {
      // A student may read only their own assignments; an admin may read
      // any. Both single-doc gets and collection queries follow the same
      // rule — for `list`, the client's query must include
      // where('studentId','==', request.auth.uid) so Firestore can prove
      // every possible result satisfies this per-document check.
      allow get, list: if isActiveAdmin()
                       || (request.auth != null && resource.data.studentId == request.auth.uid);

      // Only admins assign missions. MissionService.assignMission already
      // validates the mission is published and the student is active
      // before this write ever happens — this rule is the authorization
      // boundary, not the full business-rule set.
      allow create: if isActiveAdmin();

      // Assignments are immutable once created in Phase 1 — no partial
      // updates, no client-side unassign yet.
      allow update: if false;
      allow delete: if false;
    }
  }
}
